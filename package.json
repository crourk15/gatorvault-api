{
  "name": "gatorvault-api",
  "version": "1.0.0",
  "private": true,
  "description": "GatorVault Insider \u2014 API, static site, On3 ingest, X AutoPoster",
  "scripts": {
    "postinstall": "npm install --prefix server",
    "build:futurecast": "npm run build:render --prefix client",
    "build:netlify": "node scripts/clean-publish-artifacts.js && node server/scripts/validate-target-allowlist.js && npm ci --prefix client --legacy-peer-deps && node client/scripts/verify-recruiting-cycle-exports.js && node client/scripts/generate-recruiting-hub-hero-seed.js && node client/scripts/generate-recruiting-hub-bundle-seed.js && node client/scripts/generate-team-hub-seed.js && node client/scripts/generate-gnl-hub-seed.js && node client/scripts/generate-futurecast-lab-seed.js && node client/scripts/generate-nil-hub-seed.js && node client/scripts/generate-alerts-hub-seed.js && node client/scripts/generate-film-room-hub-seed.js && node client/scripts/generate-community-hub-seed.js && node client/scripts/generate-articles-hub-seed.js && node client/scripts/generate-game-zone-hub-seed.js && npm run build --prefix client && node client/scripts/generate-redirects.js && node client/scripts/merge-into-server.js && node client/scripts/generate-aasa.js && node server/scripts/validate-target-allowlist.js",
    "clean:publish": "node scripts/clean-publish-artifacts.js",
    "deploy:netlify:full": "node scripts/deploy-netlify-full.js",
    "deploy:netlify:local": "node scripts/deploy-netlify-full.js --skip-deploy --skip-purge",
    "verify:encoding": "node server/scripts/encoding-check.js --mount",
    "hooks:install": "node server/scripts/install-git-hooks.js",
    "ops:futurecast": "node server/scripts/run-production-cleanup.js --futurecast",
    "deploy:guardian": "node server/scripts/deploy-guardian.js --phase=pre --api",
    "deploy:guardian:static": "node server/scripts/deploy-guardian.js --phase=pre --static --skip-api",
    "deploy:smoke": "node server/scripts/deploy-smoke-post.js",
    "deploy:netlify": "node scripts/trigger-netlify-deploy.js",
    "purge:netlify-cdn": "node scripts/purge-netlify-cdn.js",
    "verify:hydration:local": "node server/scripts/verify-hydration-stability.js",
    "verify:hydration:production": "node server/scripts/verify-hydration-production.js",
    "verify:qa:local": "node server/scripts/verify-qa-markers-local.js",
    "verify:qa:production": "node server/scripts/verify-qa-markers-production.js",
    "verify:mobile:full": "node client/scripts/run-full-mobile-verify.js",
    "verify:mobile:app": "node client/scripts/verify-full-mobile-app.js",
    "proof:mobile:capture": "node client/scripts/capture-mobile-deploy-proof.js",
    "proof:mobile:deploy": "node client/scripts/run-mobile-deploy-proof.js",
    "verify:netlify:build": "node client/scripts/verify-netlify-build-match.js",
    "verify:cold-start:api": "node client/scripts/verify-cold-start-api.js",
    "verify:mobile:hardening": "node client/scripts/verify-mobile-hardening.js",
    "verify:player-nav": "node client/scripts/verify-all-player-nav-safe.js && node client/scripts/verify-early-discovery-player-nav.js && node client/scripts/verify-roster-player-nav.js",
    "verify:ios:iap": "node client/scripts/verify-ios-iap-wiring.js",
    "audit:target-stubs": "node server/scripts/audit-target-stubs.js",
    "audit:prod-board": "node server/scripts/audit-prod-allowlist-board.js",
    "sync:allowlist-on3": "npm run sync:allowlist-on3 --prefix server",
    "backfill:allowlist-intel-skinny": "npm run backfill:allowlist-intel-skinny --prefix server",
    "sync:recruiting:json-slugs": "node server/scripts/sync-allowlist-json-to-prod.js",
    "sync:recruiting:2027-board": "node server/scripts/sync-allowlist-json-to-prod.js",
    "sync:recruiting:2028-board": "node server/scripts/sync-allowlist-json-to-prod.js --class-year=2028",
    "fix:unverified-uf-commits": "node server/scripts/demote-unverified-hub-commits.js --sync-allowlist",
    "fix:unverified-uf-commits:prod": "node server/scripts/sync-allowlist-json-to-prod.js",
    "deploy:render": "node server/scripts/deploy-render.js --deploy --clear-cache",
    "start": "npm start --prefix server",
    "dev": "npm run dev --prefix server",
    "ingest:on3": "npm run ingest:on3 --prefix server",
    "ingest:on3:baseline": "npm run ingest:on3:baseline --prefix server",
    "ingest:media": "npm run ingest:media --prefix server",
    "verify:x": "npm run verify:x --prefix server",
    "run:x-autoposter": "npm run run:x-autoposter --prefix server",
    "sync:portal": "npm run sync:portal --prefix server",
    "ensure:film-room": "npm run ensure:film-room --prefix server",
    "seed:recruiting": "npm run seed:recruiting --prefix server",
    "seed:hub-intel": "npm run seed:hub-intel --prefix server",
    "mobile:sync": "npm run build --prefix client && npm run cap:sync --prefix client",
    "mobile:ios": "npm run cap:ios --prefix client",
    "capture:app-store-screenshots": "node scripts/capture-app-store-screenshots.js",
    "generate:ipad-screenshots": "node scripts/generate-ipad-app-store-screenshots.js",
    "verify:app-store-screenshots": "node scripts/verify-app-store-screenshots.js",
    "smoke:app-store": "node scripts/app-store-smoke.js",
    "provision:app-review": "node scripts/provision-app-review-account.js",
    "prep:app-store": "node scripts/app-store-prep.js",
    "walkthrough:app-store": "node scripts/app-store-connect-walkthrough.js",
    "trigger:codemagic:ios": "node scripts/trigger-codemagic-ios.js",
    "test:account-delete": "node scripts/test-account-delete.js",
    "verify:ios:smoke": "node client/scripts/verify-ios-smoke.js",
    "verify:native-deep-link": "node client/scripts/verify-native-deep-link.js",
    "proof:mobile:prod": "PROOF_BASE=https://gatorvaultinsider.com VERIFY_BASE=https://gatorvaultinsider.com node client/scripts/load-proof-env.js client/scripts/run-mobile-deploy-proof.js --verify-production",
    "proof:env:check": "node client/scripts/load-proof-env.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "^1.61.0"
  }
}
