{
  "version": "5.0.0",
  "engine": "self-runner-v3",
  "architecture": "react",
  "v3": {
    "enabled": true,
    "opsOnly": true,
    "defaultMode": "scan-only",
    "autoHealFixTypes": ["data", "config", "cron", "ingest"],
    "blockedFixTypes": ["layout", "code"],
    "verification": {
      "qaCrawlAfterApply": true,
      "recomputeProductHealth": true,
      "rollbackOnHealthDrop": true,
      "healthDropThreshold": 2
    },
    "confidenceBands": {
      "never_auto": [0, 40],
      "propose_only": [40, 70],
      "guarded_auto": [70, 90],
      "fully_trusted": [90, 100]
    }
  },
  "retiredPatchTypes": [
    "html-hook",
    "html-hook-v2",
    "ensure-team-shell",
    "background-theme",
    "missing-content",
    "team-content",
    "component-variant",
    "react-component",
    "react-route",
    "react-component-review",
    "react-css",
    "react-rebuild",
    "layout-overflow",
    "panel-layering",
    "ordering-fix"
  ],
  "allowedPatchTypes": [
    "feed-dedup-v2",
    "film-source-url",
    "schema-field-v2",
    "war-room-refresh",
    "war-room-missing-card",
    "queue-scouting-refresh",
    "multi-file-v2",
    "autoposter-force-run"
  ],
  "forbiddenFiles": [
    "legacy-index.html",
    "js/gv-team-mobile.js",
    "css/gv-team.css"
  ],
  "forbiddenEditTypes": [
    "ensure-team-shell",
    "add-class-to-region",
    "remove-class-from-region",
    "class-swap-in-region",
    "insert-after-region-open",
    "insert-after-anchor",
    "html-hook",
    "html-hook-v2",
    "verify-hooks"
  ],
  "reactPatchTypes": {
    "react-route": { "risk": "medium", "v3Blocked": true },
    "react-component": { "risk": "medium", "v3Blocked": true },
    "react-css": { "risk": "low", "v3Blocked": true },
    "react-slug": { "risk": "medium", "v3Blocked": true },
    "react-rebuild": { "risk": "low", "v3Blocked": true },
    "feed-dedup-v2": { "risk": "low", "fixType": "data", "files": ["data/live/feed-items.json"] },
    "film-source-url": { "risk": "low", "fixType": "data", "files": ["data/film-room-knowledge/"] },
    "schema-field-v2": { "risk": "low", "fixType": "data", "files": ["data/"] }
  },
  "validatorRules": {
    "component": ["testid", "export", "hydration"],
    "route": ["rewrite", "staticExport", "redirect"],
    "slug": ["ensurePlayerSlug", "playerProfilePath"],
    "layout": ["scrollContainer", "safeArea", "modalZIndex"]
  },
  "explainerTemplates": {
    "missing-component": "React component {component} missing — manual fix required (v3 does not auto-edit TSX)",
    "broken-route": "Route {route} missing — manual fix required",
    "feed-integrity": "Repair data/live/feed-items.json via feed-dedup-v2 playbook",
    "uuid-mismatch": "Resolve slug→UUID before DB write — see data-uuid-integrity playbook"
  }
}
