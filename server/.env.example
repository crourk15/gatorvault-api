# GatorVault server — EmailJS + Beehiiv onboarding
PORT=3000
SITE_URL=https://gatorvaultinsider.com

# Beehiiv (optional — newsletter only; welcome email is sent via EmailJS on signup)
# BEEHIIV_API_KEY=
# BEEHIIV_PUBLICATION_ID=pub_xxxxxxxx
# BEEHIIV_ONBOARDING_AUTOMATION_ID=aut_xxxxxxxx
SESSION_SECRET=replace-with-long-random-secret
EMAIL_PROVIDER=emailjs

# EmailJS — server REST uses Private Key Mode (accessToken only, no user_id in payload).
# New accounts use short keys like vBlY3DbhS-RZH4tCM — no prefix required.
# Enable: Account → Security → "Allow EmailJS API for non-browser applications"
EMAILJS_USER_ID=vBlY3DbhS-RZH4tCM
EMAILJS_PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE
EMAILJS_SERVICE_ID=service_ul7ju9p
EMAILJS_TEMPLATE_ID=template_okh1hj8
# Optional legacy — not used (single welcome template only)
# EMAILJS_ONBOARDING_TEMPLATE_ID=template_xxxxxxxx
EMAILJS_REPLY_TO=gatorvaultinsider@gmail.com

# Render deploy/sync (optional — for scripts/sync-render-env.js)
# RENDER_API_KEY=rnd_...
# Render deploy hook — Dashboard → gatorvault-api → Settings → Deploy Hook
# RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-...

# Primary operator/admin password (PIN login, recruiting admin routes, cron secrets)
ADMIN_PASSWORD=GV2026admin

# Optional — PIN for /test-email.html and /api/test/* routes (defaults to admin PIN)
EMAIL_TEST_PIN=GV2026admin
RECRUITING_ADMIN_PIN=GV2026admin

# Recruiting live data — Supabase `players` table (preferred) or local JSON fallback
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# FutureCast Postgres (Supabase shared pooler — port 6543)
# Dashboard → Project Settings → Database → Connection string → URI (Session pooler)
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Migration: set SUPABASE_URL + SUPABASE_SERVICE_KEY for recruiting players/commits;
# set DATABASE_URL for FutureCast predictions/movement. Snapshots rebuild from store at deploy.

# Allow-list target profile sync during On3 ingest (set false to skip)
# ALLOWLIST_TARGET_SYNC=true
# RECRUITING_HUB_REFRESH_AFTER_INGEST=true

# Recruiting pipeline monitoring (optional)
# MONITORING_SECRET=GV2026admin
# MONITORING_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# MONITORING_ALERT_EMAIL=you@example.com
# MONITORING_INGEST_STALE_MS=7200000
# MONITORING_BEAT_STALE_MS=900000
# MONITORING_AUTOPOSTER_IDLE_MS=21600000
# MONITORING_HEALTH_INTERVAL_MS=900000
# MONITORING_HEALTH_BOOT_DELAY_MS=180000
# BEAT_LATE_INGEST_INTERVAL_MS=300000
# BEAT_LATE_INGEST_BOOT_DELAY_MS=60000

# Phase 2 — On3 Florida ingest (optional)
# First run saves a baseline snapshot (no alerts). Then diffs fire commit/flip/decommit events.
ON3_INGEST_ENABLED=false
ON3_INGEST_INTERVAL_MS=120000
ON3_INGEST_BOOT_DELAY_MS=15000
ON3_CLASS_YEARS=2026,2027
ON3_ORG_SLUG=florida-gators

# Rivals Prediction Machine ingest
# RIVALS_PM_INGEST_ENABLED=true
# RIVALS_PM_INTERVAL_MS=300000
# RIVALS_PM_BOOT_DELAY_MS=45000
# RIVALS_PM_CLASS_YEARS=2027,2028,2029
# RIVALS_PM_BACKFILL=true

# PR-6 elite rewrite — shadow on by default; live applies golden four only when enabled
# X_AUTOPOST_PR6_SHADOW=true
# X_AUTOPOST_PR6_ENABLED=true
# PR-7/8/9 enhancement — shadow until PR-6 soft launch is clean; live golden four only when enabled
# X_AUTOPOST_PR7_8_9_SHADOW=true
# X_AUTOPOST_PR7_8_9_ENABLED=true

# PR-789 dominant angle — one arc delivery (shadow on by default; live golden four only when enabled)
# X_AUTOPOST_PR789_ANGLE_SHADOW=true
# X_AUTOPOST_PR789_ANGLE_ENABLED=false

# X Premium / verified long posts — default 500; set up to 4000 for longer elite copy
# X_CHAR_LIMIT=500

# GatorVault X AutoPoster — OAuth 1.0a posting as @gatorvault (NOT Bearer / OAuth 2.0)
# See docs/x-autoposter-setup.md
# UF Premium full activation — node server/scripts/activate-uf-premium-system.js --full
X_AUTOPOST_ENABLED=true
X_GM2_REWRITE_ENABLED=true
X_INTEL_REWRITE_ENABLED=true
X_AUTOPOST_ELITE_MODE=true
# G1: PR-789 fused compose only for recruiting player intel (enrich until elite; blocks thin legacy)
X_AUTOPOST_PR789_ONLY_RECRUITING=true
# Hub-first Post Studio — compose in Admin Hub, post manually on X (no API credits).
# Autoposter scheduler is OFF by default in hub mode (no automatic API posts).
X_AUTOPOST_HUB_MODE=true
X_AUTOPOST_SCHEDULER_ENABLED=false
X_AUTOPOST_DAILY_MAX=2
X_AUTOPOST_AUTO_QUEUE_MAX=2
# Commits go to Post Studio by default; set true to auto-queue UF commits for API posting.
# X_AUTOPOST_AUTO_COMMITS=false
# Routine beat/intel posts may still fill the small auto queue when slots remain.
# X_AUTOPOST_AUTO_ROUTINE=true
# X_AUTOPOST_REFILL_MIN_HUB=5
# Self-healing autoposter — auto-republish when elite stack drifts (default on)
# X_AUTOPOST_SELF_HEAL=false
# X_AUTOPOST_SELF_HEAL_MAX_PER_TICK=2
# X_AUTOPOST_SELF_HEAL_THROTTLE_MS=300000
# X_AUTOPOST_SELF_HEAL_AUTO_POST=false
X_AUTOPOST_MAX_INTEL_AGE_MS=14400000
X_AUTOPOST_INTEL_FRESHNESS_MS=14400000
X_AUTOPOST_MAX_BEAT_AGE_MS=14400000
X_AUTOPROMPT_ENABLED=true
X_AUTOPOST_REWRITE_FALLBACK=true
X_AUTOPOST_GV_CTA_ENABLED=true
ON3_INGEST_ENABLED=true
ON3_CLASS_YEARS=2026,2027,2028,2029,2030
RIVALS_PM_INGEST_ENABLED=true
RIVALS_PM_CLASS_YEARS=2027,2028,2029,2030
MOVEMENT_ENGINE_ENABLED=true
FUTURECAST_MOVEMENT_ENABLED=true
FUTURECAST_FIT_RECALC_ENABLED=true
FUTURECAST_COMPETITOR_TRACKING_ENABLED=true
UNDERCLASSMEN_DISCOVERY_ENABLED=true
PORTAL_MOVEMENT_ENABLED=true
NIL_MOVEMENT_ENABLED=true
SCOUTING_UPDATE_ENABLED=true
# X_AUTOPOST_MAX_INTEL_AGE_MS=3600000
# X_AUTOPOST_INTEL_FRESHNESS_MS=3600000
# X_OAUTH1_API_KEY=your_consumer_api_key
# (aliases also supported: TWITTER_API_KEY, TWITTER_API_SECRET, TWITTER_ACCESS_TOKEN, TWITTER_ACCESS_SECRET)
# X_OAUTH1_API_SECRET=your_consumer_api_secret
# X_OAUTH1_ACCESS_TOKEN=your_access_token
# X_OAUTH1_ACCESS_TOKEN_SECRET=your_access_token_secret
# X_AUTOPOST_ENABLED=false
# X_AUTOPOST_INTERVAL_MS=60000
# X_AUTOPOST_COOLDOWN_MS=2700000
# X_AUTOPOST_BURST_MS=420000
# X_AUTOPOST_NIGHT_MS=9000000
# X_AUTOPOST_BREAKING_BURST_MS=120000
# X_AUTOPOST_NIGHT_TZ=America/New_York
# X_AUTOPOST_ALLOW_PROMO=false
# X_AUTOPOST_QUOTE_OVERLAP_MAX=0.2
# X_AUTOPOST_QUOTE_REGEN_ATTEMPTS=4
# X_AUTOPOST_MIN_REWRITE_WORDS=40
# X_AUTOPOST_REWRITE_FALLBACK=true
# X_AUTOPROMPT_ENABLED=true
# X_AUTOPOST_GV_CTA_ENABLED=true
# X_AUTOPOST_INTEL_FRESHNESS_MS=172800000
# X_AUTOPOST_ELITE_MODE=true
# X_AUTOPOST_BOOT_DELAY_MS=20000
# X_AUTOPOST_ACCOUNT=gatorvault
# X_AUTOPOST_PIN=GV2026admin
# X_AUTOPOST_CRON_SECRET=GV2026admin
# ON3_API_BASE=https://www.on3.com/sites/api/rdb/organizations
# INGEST_CRON_SECRET=GV2026admin

# GatorNation Live Dashboard (beat writers, podcasts, unified feed)
# Pipeline schedulers — REQUIRED on Render for beat ingest + live refresh:
# X_PIPELINES_ENABLED=true
# X_SCHEDULED_JOBS_ENABLED=true
# X_GM2_REWRITE_ENABLED=true
# X_INTEL_REWRITE_ENABLED=true
# MONITORING_CRON_SECRET=<same secret on web service + Render cron jobs>
# REQUIRED on Render for Beat Writer Stream (Live Dashboard → Beat Writer Stream):
# 1. Render Dashboard → gatorvault-api → Environment
# 2. Add: X_BEARER_TOKEN = <raw Bearer Token from developer.x.com — use exactly as provided>
# 3. Save and redeploy — beat feed auto-refreshes every 3 minutes
# X_BEARER_TOKEN=your_twitter_api_v2_bearer_token
# NITTER_BASES=https://nitter.poast.org,https://nitter.privacydev.net
# LIVE_POLL_INTERVAL_MS=180000
# LIVE_POLL_BOOT_DELAY_MS=20000
# LIVE_CRON_SECRET=GV2026admin
# LIVE_ADMIN_PIN=GV2026admin

# Highlight + Interview ingestion pipeline (see docs/media-ingest-setup.md)
# Requires ffmpeg on PATH for processing. Inbox sources work without API keys.
# MEDIA_INGEST_ENABLED=false
# MEDIA_INGEST_INTERVAL_MS=900000
# MEDIA_INGEST_BOOT_DELAY_MS=45000
# MEDIA_INGEST_BATCH_LIMIT=5
# MEDIA_INGEST_PIN=GV2026admin
# MEDIA_CDN_BASE=https://gatorvault-api.onrender.com

# Optional
DIGEST_TOKEN=
DEFAULT_WEBHOOK=

# War Room — continuous scouting update engine (all players, NFL vs recruiting pipelines)
# SCOUTING_UPDATE_ENABLED=true
# SCOUTING_UPDATE_INTERVAL_MS=21600000
# SCOUTING_UPDATE_DELAY_MS=400
# SCOUTING_UPDATE_LOG_MAX=500
# SCOUTING_REBUILD_DELAY_MS=400

# Self-Runner 2.0 — platform blueprint brain (assisted mode default)
# Memory guard — API baseline RSS ~650–700MB after G1–G5; 420 blocks Post Studio refill
# MEMORY_GUARD_RSS_MB=720
# POST_STUDIO_REFILL_MAX_RSS_MB=850
# SELF_RUNNER_V2_SCAN=false
# SELF_RUNNER_POST_QA_DELAY_MS=45000
# Self-Runner v3 — governed auto-healing (ops/data fixes only)
# SELF_RUNNER_V3=true
# SELF_RUNNER_MODE=scan-only
# App Store gate: 7 consecutive green UTC days before submission (see scripts/app-store-stability-check.js)
# APP_STORE_GATE_DAYS=7
# APP_STORE_GATE_PI_MIN=90
# Modes: scan-only | assisted | guarded-apply | full-auto-heal
# SELF_RUNNER_AUTO_HEAL_SUBSYSTEMS=autoposter,feed,recruiting,portal,cron
# SELF_RUNNER_V2_SCAN=true
# SELF_RUNNER_DEDUPE_WINDOW_SEC=21600
# SELF_RUNNER_SCOUTING_STALE_DAYS=30
# SELF_RUNNER_LOG_MAX=2000

# Apple IAP / StoreKit (Step 3b — keep false until App Store Connect keys are set)
# APPLE_IAP_VERIFICATION_ENABLED=false
# APPLE_IAP_KEY_ID=
# APPLE_IAP_ISSUER_ID=
# APPLE_IAP_BUNDLE_ID=com.gatorvaultinsider.app
# APPLE_IAP_PRIVATE_KEY=   # .p8 contents or base64
# APPLE_IAP_SANDBOX=true   # use sandbox StoreKit API during TestFlight
