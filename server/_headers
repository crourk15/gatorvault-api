# Published with server/ — must match netlify.toml cache policy.
# HTML/RSC shells: never cache (prevents stale chunk refs + mixed build versions).
# Hashed assets (_next/static, js/vault-chunks): immutable (set in netlify.toml).

/
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache
  Expires: 0
  Netlify-CDN-Cache-Control: no-store

/*.html
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache
  Expires: 0
  Netlify-CDN-Cache-Control: no-store

/*.txt
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache
  Expires: 0
  Netlify-CDN-Cache-Control: no-store

/vault/*
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache
  Expires: 0
  Netlify-CDN-Cache-Control: no-store

/futurecast/*
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache
  Expires: 0
  Netlify-CDN-Cache-Control: no-store

/build-manifest.json
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache
  Netlify-CDN-Cache-Control: no-store

/ops-version.json
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache
  Netlify-CDN-Cache-Control: no-store

/js/vault-route-manifest.json
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache
  Netlify-CDN-Cache-Control: no-store

/og-image.png
  Content-Type: image/png
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/og-image.jpg
  Content-Type: image/jpeg
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/favicon.ico
  Content-Type: image/x-icon
  Cache-Control: public, max-age=604800

/sitemap.xml
  Content-Type: application/xml
  Cache-Control: public, max-age=86400

/favicon-32.png
  Content-Type: image/png
  Cache-Control: public, max-age=604800

/favicon-48.png
  Content-Type: image/png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Content-Type: image/png
  Cache-Control: public, max-age=604800

/favicon.svg
  Content-Type: image/svg+xml
  Cache-Control: public, max-age=604800

/index.html
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache
  Expires: 0
  Netlify-CDN-Cache-Control: no-store
